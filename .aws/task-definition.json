{
  "family": "coffee-shop-pos",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "coffee-shop-pos",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/coffee-shop-pos:latest",
      "dependsOn": [
        {
          "containerName": "immudb",
          "condition": "START"
        }
      ],
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "DB_PORT",
          "value": "3306"
        },
        {
          "name": "DB_DATABASE",
          "value": "app_db"
        },
        {
          "name": "DB_USERNAME",
          "value": "app_user"
        },
        {
          "name": "DB_SYNC",
          "value": "false"
        },
        {
          "name": "FRONTEND_URL",
          "value": "<YOUR_DOMAIN>"
        },
        {
          "name": "IMMUDB_HOST",
          "value": "localhost"
        },
        {
          "name": "IMMUDB_PORT",
          "value": "3322"
        },
        {
          "name": "IMMUDB_USER",
          "value": "immudb"
        },
        {
          "name": "IMMUDB_DATABASE",
          "value": "defaultdb"
        }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/db-host-gQgA9y"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/db-password-vtcduk"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/jwt-secret-3CMEXn"
        },
        {
          "name": "SESSION_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/session-secret-2R2Ddu"
        },
        {
          "name": "SEPAY_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/sepay-api-key-Ji4aMI"
        },
        {
          "name": "SEPAY_ACCOUNT_NUMBER",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/sepay-account-number-2gELCG"
        },
        {
          "name": "SEPAY_BANK_NAME",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/sepay-bank-name-xk7WfJ"
        },
        {
          "name": "IMMUDB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:<AWS_REGION>:<AWS_ACCOUNT_ID>:secret:coffee-shop-pos/immudb-password"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/coffee-shop-pos",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    },
    {
      "name": "immudb",
      "image": "codenotary/immudb:latest",
      "portMappings": [
        {
          "containerPort": 3322,
          "protocol": "tcp"
        },
        {
          "containerPort": 9497,
          "protocol": "tcp"
        },
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "IMMUDB_ADMIN_PASSWORD",
          "value": "immudb"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/coffee-shop-pos",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "immudb"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "immuadmin audit status || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ]
}

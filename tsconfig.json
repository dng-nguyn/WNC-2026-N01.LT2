{
  "compilerOptions": {
    "rootDir": "./backend/src",
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node10",
    "types": ["node"],
    "strictPropertyInitialization": false,
    "ignoreDeprecations": "6.0",
  },
  "include": ["backend/src/**/*.ts"],
  "exclude": ["node_modules", "dist", "backend/test", "**/*.spec.ts"]
}
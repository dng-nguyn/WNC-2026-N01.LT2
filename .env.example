DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_DATABASE=Quan_Ly_Quan_Cafe

# Optional: path to CA certificate for SSL connections (production)
DB_SYNC=true
# DB_SSL_CA=/path/to/ca-cert.pem

NODE_ENV=development
FRONTEND_URL=http://localhost:5173

JWT_SECRET=test-jwt-secret-change-me
SESSION_SECRET=test-session-secret-change-me
PORT=3000
SEPAY_API_KEY=your_sepay_api_key
SEPAY_ACCOUNT_NUMBER=3669420000
SEPAY_BANK_NAME=MBBank

# Immudb (immutable audit log — optional, gracefully degrades if unavailable)
IMMUDB_HOST=localhost
IMMUDB_PORT=3322
IMMUDB_USER=immudb
IMMUDB_PASSWORD=immudb
IMMUDB_DATABASE=defaultdb

# Admin auto-create (created on startup if no MANAGER user exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Change-me-in-production

# Frontend (Vite dev server)
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:3000